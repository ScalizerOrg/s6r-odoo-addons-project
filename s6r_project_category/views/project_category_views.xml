<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_category_list" model="ir.ui.view">
        <field name="name">project.category.list</field>
        <field name="model">project.category</field>
        <field name="arch" type="xml">
            <list string="Project Categories" editable="bottom" default_order="sequence, name">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_project_category_form" model="ir.ui.view">
        <field name="name">project.category.form</field>
        <field name="model">project.category</field>
        <field name="arch" type="xml">
            <form string="Project Category">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_project_category_search" model="ir.ui.view">
        <field name="name">project.category.search</field>
        <field name="model">project.category</field>
        <field name="arch" type="xml">
            <search string="Project Categories">
                <field name="name"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archived"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_project_category" model="ir.actions.act_window">
        <field name="name">Project Categories</field>
        <field name="res_model">project.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_project_category_search"/>
    </record>

    <menuitem
            id="menu_project_category"
            name="Project Categories"
            parent="project.menu_project_config"
            action="action_project_category"
            sequence="50"
            groups="project.group_project_manager"
    />
</odoo>
